
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ringo Bongo Widget</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: flex-end;
  align-items: flex-end;
  padding: 15px;
  background: transparent;
  font-family: Arial, sans-serif;
  color: white;
}

.widget {
  width:  min(100%, 520px);
  overflow: hidden;
  border: 5px solid #ff9d18;
  border-radius: 17px;
  background: #242424;
  box-shadow:
    0 0 0 3px #662c13,
    0 0 18px #ff941c;
}

.header {
  padding: 9px 14px;
  background: linear-gradient(90deg, #ff9d18, #e63b16);
  color: #21150b;
  font-weight: 900;
  letter-spacing: 2px;
  display: flex;
  justify-content: space-between;
}

.stage {
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at center, #555 0%, #292929 70%);
  border-bottom: 4px solid #ff9d18;
}

#ringo {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  display: none;
}

.placeholder {
  text-align: center;
  color: #ffbd55;
  padding: 20px;
}

.placeholder .cat {
  font-size: 65px;
}

.placeholder p {
  font-size: 13px;
}

.keyboard {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: linear-gradient(#343434, #171717);
}

.key-row {
  display: flex;
  justify-content: center;
  gap: 4px;
}

.key {
  flex: 1;
  min-width: 0;
  height: 34px;
  border: 1px solid #777;
  border-bottom: 4px solid #555;
  border-radius: 5px;
  background: #252525;
  color: white;
  font-size: 10px;
  font-weight: bold;
  cursor: pointer;
  padding: 0 2px;
}

.key.active {
  background: #ff9d18;
  color: #241408;
  border-color: #ffdb76;
  box-shadow: 0 0 12px #ff9d18;
  transform: translateY(2px);
}

.key.wide {
  flex: 1.7;
}

.key.space {
  flex: 5;
}

.footer {
  padding: 7px;
  text-align: center;
  font-size: 10px;
  color: #ffbd55;
  background: #171717;
}
</style>
</head>

<body>

<div class="widget">

  <div class="header">
    <span>RINGO GAMING</span>
    <span>● LIVE</span>
  </div>

  <div class="stage">
    <img id="ringo" alt="Ringo">
    <div class="placeholder" id="placeholder">
      <div class="cat">🐱</div>
      <strong>RINGO</strong>
      <p>Aquí aparecerán tus imágenes</p>
    </div>
  </div>

  <div class="keyboard" id="keyboard"></div>

  <div class="footer">
    RINGO BONGO SYSTEM • GAMING MODE
  </div>

</div>

<script>
// =================================
// AQUÍ PONDREMOS LAS 8 IMÁGENES
// =================================

const images = {
  normal: "imagenes/ringo-normal.png",
  ojosCerrados: "imagenes/ringo-ojos-cerrados.png",
  bocaAbierta: "imagenes/ringo-boca-abierta.png",
  ojosCerradosBocaAbierta: "imagenes/ringo-ojos-cerrados-boca-abierta.png",

  teclado: "imagenes/ringo-teclado.png",
  tecladoOjosCerrados: "imagenes/ringo-teclado-ojos-cerrados.png",
  tecladoBocaAbierta: "imagenes/ringo-teclado-boca-abierta.png",
  tecladoOjosCerradosBocaAbierta: "imagenes/ringo-teclado-ojos-cerrados-boca-abierta.png"
};

// =================================
// CONFIGURACIÓN DEL PERSONAJE
// =================================

const ringo = document.getElementById("ringo");
const placeholder = document.getElementById("placeholder");

function showRingo(imageName) {
  const imagePath = images[imageName];

  ringo.onload = () => {
    ringo.style.display = "block";
    placeholder.style.display = "none";
  };

  ringo.onerror = () => {
    ringo.style.display = "none";
    placeholder.style.display = "block";
  };

  ringo.src = imagePath;
}

function updateRingo() {
  showRingo(isPressed ? "teclado" : "normal");
}

// =================================
// CREAR EL TECLADO
// =================================

const rows = [
  ["ESC", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BACK"],
  ["TAB", "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
  ["CAPS", "A", "S", "D", "F", "G", "H", "J", "K", "L", "ENTER"],
  ["SHIFT", "Z", "X", "C", "V", "B", "N", "M", "SHIFT"],
  ["CTRL", "ALT", "SPACE", "ALT", "CTRL"]
];

const keyboard = document.getElementById("keyboard");

rows.forEach(row => {
  const rowElement = document.createElement("div");
  rowElement.className = "key-row";

  row.forEach(keyName => {
    const key = document.createElement("button");
    key.className = "key";
    key.textContent = keyName;
    key.dataset.key = keyName;

    if (["SPACE"].includes(keyName)) key.classList.add("space");
    if (["SHIFT", "ENTER", "BACK", "CTRL", "ALT", "TAB", "CAPS"].includes(keyName)) {
      key.classList.add("wide");
    }

    key.addEventListener("pointerdown", () => pressKey(keyName));
    key.addEventListener("pointerup", releaseKey);
    key.addEventListener("pointerleave", releaseKey);

    rowElement.appendChild(key);
  });

  keyboard.appendChild(rowElement);
});

// =================================
// ANIMACIÓN DE LAS TECLAS
// =================================

let isPressed = false;

function pressKey(keyName) {
  isPressed = true;
  highlightKey(keyName);
  updateRingo();
}

function releaseKey() {
  isPressed = false;
  clearKeys();
  updateRingo();
}

function highlightKey(keyName) {
  clearKeys();

  document.querySelectorAll(".key").forEach(key => {
    if (key.dataset.key === keyName) {
      key.classList.add("active");
    }
  });
}

function clearKeys() {
  document.querySelectorAll(".key").forEach(key => {
    key.classList.remove("active");
  });
}

// También reconoce teclas de un teclado físico
document.addEventListener("keydown", event => {
  if (event.repeat) return;

  isPressed = true;

  const keyName = event.key.toUpperCase();
  highlightKey(keyName === " " ? "SPACE" : keyName);

  updateRingo();
});

document.addEventListener("keyup", () => {
  releaseKey();
});

window.addEventListener("blur", releaseKey);

// Mostrar personaje inicial
showRingo("normal");
</script>

</body>
</html>
